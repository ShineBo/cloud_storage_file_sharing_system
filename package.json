{
  "name": "se-final-project",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "dev:web": "npm run dev --workspace @se-final/web --",
    "dev:api": "npm run dev --workspace @se-final/api --",
    "start:web": "npm run start --workspace @se-final/web --",
    "start:api": "npm run start --workspace @se-final/api --",
    "local:configure": "node scripts/local-config.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0"
  }
}
